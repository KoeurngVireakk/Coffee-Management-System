    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List products",
        "description": "All active staff. Fixed name ASC, id ASC. Unknown query fields including sort rejected. Standard Laravel pagination; no cache.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "category_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Nonexistent category produces empty results"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "default": "active"
            },
            "description": "active = sellable; inactive = product or category retired; all/inactive manager/admin only"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80
            },
            "description": "Literal name or SKU substring, wildcard characters escaped"
          },
          {
            "name": "per_page",
            "in": "query",
