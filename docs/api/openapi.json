                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sanctum token issued by login; staff ability required. Browser session/cookie auth is not implemented."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "device_name"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          },
          "device_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email",
          "role",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Synthetic cashier"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "cashier@example.test"
          },
          "role": {
            "type": "string",
            "enum": [
              "cashier",
              "manager",
              "admin"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "view-catalog",
                "process-pos",
                "view-own-orders",
                "view-inventory",
                "manage-catalog",
                "view-all-orders",
                "adjust-inventory",
                "view-reports",
                "view-settings",
                "manage-staff",
                "manage-settings"
              ]
            }
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "token",
          "token_type",
          "expires_at"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "example": "1|SYNTHETIC_TOKEN_PLACEHOLDER",
            "description": "Plaintext credential returned once; never log"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "is_active": {
            "type": "boolean"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category_id",
          "category",
          "sku",
          "name",
          "description",
          "price_minor",
          "currency",
          "is_active",
          "is_sellable",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "category_id": {
            "type": "integer",
            "format": "int64"
          },
          "category": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "is_active"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "name": {
                "type": "string"
              },
              "is_active": {
                "type": "boolean"
              }
            }
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_minor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})$",
            "maxLength": 6,
            "description": "Exact USD cents, canonical integer string 0-999999. No JSON numbers or fractional cents."
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "is_active": {
            "type": "boolean"
          },
          "is_sellable": {
            "type": "boolean",
            "description": "Product AND category active; computed read-only; future checkout must revalidate",
            "readOnly": true
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "StoreCategoryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Nonblank after whitespace trimming; names need not be unique"
          },
          "is_active": {
            "type": "boolean",
            "description": "Strict JSON boolean; defaults true on create"
          }
        }
      },
      "UpdateCategoryRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Nonblank after whitespace trimming; names need not be unique"
          },
          "is_active": {
            "type": "boolean",
            "description": "Strict JSON boolean; defaults true on create"
          }
        },
        "minProperties": 1,
        "description": "PUT/PATCH accept a nonempty partial update; omitted fields preserved"
      },
      "CategoryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Category"
          }
        }
      },
      "CategoryCollection": {
        "type": "object",
        "required": [
          "data",
          "links",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          },
          "links": {
            "type": "object",
            "required": [
              "first",
              "last",
              "prev",
              "next"
            ],
            "properties": {
              "first": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prev": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "current_page",
              "from",
              "last_page",
              "path",
              "per_page",
              "to",
              "total"
            ],
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "from": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "last_page": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "per_page": {
                "type": "integer"
              },
              "to": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "total": {
                "type": "integer"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "StoreProductRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "sku",
          "name",
          "price_minor",
          "currency"
        ],
        "properties": {
          "category_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Existing category; retired permitted to managers, still non-sellable"
          },
          "sku": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "description": "Trimmed and uppercased before validation; case-insensitive unique"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "price_minor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})$",
            "maxLength": 6,
            "description": "Exact USD cents, canonical integer string 0-999999. No JSON numbers or fractional cents."
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "is_active": {
            "type": "boolean",
            "description": "Strict JSON boolean; defaults true"
          }
        }
      },
      "UpdateProductRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
