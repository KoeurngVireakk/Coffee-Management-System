        "summary": "Edit / retire / reactivate category",
        "description": "Manager/admin only. Nonempty partial update; omitted fields preserved. is_active changes lifecycle without deletion.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
